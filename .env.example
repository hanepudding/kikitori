# Keep every comment on its own line: when a value is empty, dotenv reads an inline comment as the value itself.
# Relative paths resolve against the project root, not the shell's working directory; ~ is expanded. Blank values use
# the defaults.

# Needed for pyannote speaker diarization; accept the licence on the model page first:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# 0: no diarization, no HF_TOKEN needed; lines still break at sentence ends but carry no speaker
ASR_DIARIZE=1

# Where the Qwen3-ASR llama-server listens
ASR_SERVER_HOST=127.0.0.1
ASR_SERVER_PORT=8080

# Requests sent to llama-server at once; they run in parallel only if the server has at least this many slots (-np)
ASR_BATCH_SIZE=8

# Language names as Qwen3-ASR spells them: Chinese, English, Japanese, ...
ASR_LANGUAGE=Chinese

# Vocabulary files, comma-separated, one term per line
ASR_VOCAB=vocab.txt

# One sentence on what the recording is; placed before the vocabulary in the prompt
ASR_BACKGROUND=

# Number of speakers if known; leave blank to let pyannote count them
ASR_NUM_SPEAKERS=

# Chunks carry no state between them, so a longer chunk gives the model more context. Above 60 for ASR_TARGET_SEC,
# also raise max_new_tokens of Qwen3ASR in kikitori/asr.py, or the tails of long sentences get cut off.
ASR_TARGET_SEC=30
ASR_MAX_SEC=45

# Minimum line length before a sentence-final punctuation mark may end the line
ASR_MIN_SEG_SEC=1.5

# Pauses between lines shorter than this merge into the previous line; longer ones stay as real gaps
ASR_GAP_FILL_SEC=0.5

# ---- run.py ----

# Audio or video file to transcribe
ASR_SOURCE=
ASR_OUT_DIR=out

# Run once to see who is who, then fill in e.g. speaker_SPEAKER_00=Host;speaker_SPEAKER_01=Guest
ASR_SPEAKER_NAMES=

# ---- serve.py ----

SERVE_HOST=127.0.0.1
SERVE_PORT=8090

# One directory per upload: the source file, its 16 kHz wav and the transcript. Nothing here is deleted automatically.
SERVE_JOBS_DIR=jobs
