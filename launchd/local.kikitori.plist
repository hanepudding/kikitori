<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.kikitori</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/python3</string>
        <string>serve.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/kikitori</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- launchd's PATH has no Homebrew; without it ffmpeg is not found and every job fails at decoding -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/path/to/serve.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/serve.log</string>
</dict>
</plist>
